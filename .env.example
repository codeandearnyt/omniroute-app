/**
 * Environment configuration for OmniRoute deployment
 * 
 * Copy .env.example to .env and fill in the required values
 */

# Core Application
NEXT_PUBLIC_API_URL=http://localhost:20128
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATA_DIR=~/.omniroute

# Authentication
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-min-32-chars

# Provider OAuth Keys (add as needed)
# OPENROAI_CLIENT_ID=
# OPENROAI_CLIENT_SECRET=
# ANTHROPIC_CLIENT_ID=
# ANTHROPIC_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# API Keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# LiteLLM for pricing sync
LITELLM_API_KEY=your-lite llm-key

# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_URL=https://sentry.io/api/8/

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_TRACKING=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# CORS
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000